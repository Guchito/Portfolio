---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import Globe from "../components/Globe";
import AboutMe from "../components/AboutMe.astro";
import Now from "../components/Now.astro";
---

<script>
  import { stagger, spring, timeline, type TimelineDefinition } from "motion";
  import { loaderAnimation } from "../lib/constants";
  // CSS `order` reshuffles cards on mobile, so stagger by visual position, not DOM order
  const cards = [...document.querySelectorAll("#bento .card")].sort((a, b) => {
    const ra = a.getBoundingClientRect();
    const rb = b.getBoundingClientRect();
    return ra.top - rb.top || ra.left - rb.left;
  });

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        at: "-0.1",
        duration: 0.4,
        delay: stagger(0.3),
        easing: spring({ velocity: 100, stiffness: 50, damping: 10 }),
      },
    ],
  ];

  timeline(sequence as TimelineDefinition);
</script>

<Layout
  title="Agustin Gaggero — Full-Stack Software Engineer"
  description="Full-Stack Software Engineer based in Copenhagen, building production web applications, APIs, e-commerce platforms and integrations."
>
  <main
    class="text-white w-full flex flex-col items-center md:min-h-screen md:justify-center"
  >
    <div
      id="bento"
      class="m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-3 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 lg:max-h-[800px]"
    >
      <IntroCard />
      <AboutMe />
      <ContactsCard />
      <Now />
      <Card
        colSpan="md:col-span-1"
        rowSpan="md:row-span-2"
        title="Professional Experience"
        href="/work"
      >
      </Card>
      <Card colSpan="md:col-span-1" rowSpan="md:row-span-2" href="/projects/gunna">
        <div class="my-auto w-full">
          <h2>Gunna</h2>
          <p class="text-xs mt-2">
            AI running coach — Next.js · TypeScript · PostgreSQL
          </p>
        </div>
      </Card>
      <Card
        colSpan="md:col-span-1"
        rowSpan="md:row-span-2"
        title="Projects"
        href="/projects"
      >
      </Card>
      <Card
        colSpan="md:col-span-1"
        rowSpan="md:row-span-1"
        title="Based in Copenhagen"
        href="/travel"
        colorText="text-neutral-900"
        customClass="text-center"
      >
        <div class="h-full w-full absolute inset-0 -z-10">
          <Globe client:load />
        </div>
      </Card>
      <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
        <p class="text-xs leading-tight my-auto">
          © {new Date().getFullYear()} · Crafted with ♥️ using <a
            href="https://astro.build/"
            target="_blank"
            class="text-primary-500">Astro</a
          > by Agustin.
        </p>
      </Card>
    </div>
  </main>
</Layout>

<style is:global>
  /* Mobile-only reading order: intro, about, nordic charge, experience, gunna, projects, contact, countries, footer */
  @media (max-width: 767px) {
    #bento > :nth-child(1) { order: 1; }
    #bento > :nth-child(2) { order: 2; }
    #bento > :nth-child(4) { order: 3; }
    #bento > :nth-child(5) { order: 4; }
    #bento > :nth-child(6) { order: 5; }
    #bento > :nth-child(7) { order: 6; }
    #bento > :nth-child(3) { order: 7; }
    #bento > :nth-child(8) { order: 8; }
    #bento > :nth-child(9) { order: 9; }
  }
</style>
