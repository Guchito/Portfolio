---
import Globe from "../components/Globe";
import BasicLayout from "../layouts/BasicLayout.astro";
import BackLink from "../components/BackLink.astro";
---

<script>
  import { timeline, type TimelineDefinition } from "motion";

  const sequence = [
    [
      ".loaderRef",
      { opacity: [1, 0], pointerEvents: "none" },
      { easing: "ease-out" },
    ],
  ];

  timeline(sequence as TimelineDefinition);
</script>

<BasicLayout
  title="Visited Countries | Agustin Gaggero"
  description="A 3d globe showing countries that I have visited so far"
  page="travel"
>
  <BackLink />

  <!-- Globe's SVG uses preserveAspectRatio="slice", so its box must stay square or it scales up and crops -->
  <div class="h-screen w-full flex items-center justify-center">
    <div style="width: min(100vw, 100vh); height: min(100vw, 100vh);">
      <Globe client:load />
    </div>
  </div>
</BasicLayout>
