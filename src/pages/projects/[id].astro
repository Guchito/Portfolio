---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const links = [
  { label: "Live project", href: project.data.link, icon: "ri:global-line" },
  { label: "GitHub", href: project.data.github, icon: "ri:github-fill" },
];
---

<CaseStudyLayout
  title={`${project.data.title} | Agustin Gaggero`}
  description={project.data.description}
  heading={project.data.title}
  role={project.data.role}
  timeframe={project.data.timeframe}
  stack={project.data.stack}
  links={links}
  earlier={project.data.earlier}
  backHref="/projects"
>
  {
    project.data.imageMobile && (
      <Image
        src={project.data.imageMobile}
        alt={project.data.imageAlt}
        class="w-full rounded-lg border border-darkslate-100 sm:hidden"
      />
    )
  }
  <Image
    src={project.data.image}
    alt={project.data.imageAlt}
    class:list={[
      "w-full rounded-lg border border-darkslate-100",
      project.data.imageMobile && "hidden sm:block",
    ]}
  />
  <Content />
</CaseStudyLayout>
