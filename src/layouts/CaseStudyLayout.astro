---
import Layout from "./Layout.astro";
import BackLink from "../components/BackLink.astro";
import Button from "../components/Button.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  heading: string;
  tagline?: string;
  role?: string;
  timeframe?: string;
  stack?: string[];
  links?: { label: string; href: string; icon: string }[];
  backHref?: string;
  earlier?: boolean;
}

const {
  title,
  description,
  heading,
  tagline,
  role,
  timeframe,
  stack = [],
  links = [],
  backHref = "/",
  earlier = false,
} = Astro.props;
---

<script>
  import { timeline, type TimelineDefinition } from "motion";
  import { loaderAnimation } from "../lib/constants";

  timeline([loaderAnimation] as TimelineDefinition);
</script>

<Layout title={title} description={description}>
  <BackLink href={backHref} />
  <main class="w-full flex flex-col max-w-3xl mx-auto p-8 text-neutral-100">
    <header class="mt-20 mb-6 flex flex-col gap-3">
      {
        earlier && (
          <span class="text-xs uppercase tracking-wide text-gray-400 border border-neutral-600 rounded-lg px-2 py-1 w-fit">
            Earlier project
          </span>
        )
      }
      <h1 class="text-4xl font-bold m-0">{heading}</h1>
      {tagline && <p class="m-0 text-lg text-gray-300">{tagline}</p>}
      {
        (role || timeframe) && (
          <p class="m-0 text-gray-400">
            {[role, timeframe].filter(Boolean).join(" · ")}
          </p>
        )
      }
      {
        stack.length > 0 && (
          <ul class="flex flex-wrap gap-2 m-0 p-0 list-none">
            {stack.map((tech) => (
              <li class="text-sm text-gray-300 bg-darkslate-500 border border-darkslate-100 rounded-lg px-2 py-1">
                {tech}
              </li>
            ))}
          </ul>
        )
      }
      {
        links.length > 0 && (
          <div class="flex flex-wrap gap-4 mt-2">
            {links.map((link) => (
              <a href={link.href} aria-label={link.label} target="_blank">
                <Button aria-label={link.label}>
                  <Icon name={link.icon} class="h-6" />
                  <span class="sr-only">{link.label}</span>
                </Button>
              </a>
            ))}
          </div>
        )
      }
    </header>
    <article class="prose prose-invert max-w-none w-full">
      <slot />
    </article>
  </main>
</Layout>
