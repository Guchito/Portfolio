---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { Image } from "astro:assets";
---

<Card
  colSpan="md:col-span-2"
  rowSpan="md:row-span-2"
  title="Professional Experience"
  href="/work"
>
  <div class="flex items-center justify-between gap-4 my-auto w-full">
    <div class="flex flex-col gap-1">
      <div class="flex items-center gap-2">
        <Pulse />
        <p class="m-0 font-bold">Now at Nordic Charge</p>
      </div>
      <p class="m-0 text-sm font-light">
        Building and maintaining production software across their digital
        ecosystem — Marketplace, Partner Portal and API v2.
      </p>
    </div>
    <Image
      src="/Work/NordicCharge.svg"
      alt="Logo of Nordic Charge"
      width="100"
      height="100"
      class="h-12 flex-none"
    />
  </div>
</Card>
