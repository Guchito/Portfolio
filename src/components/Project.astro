---
import Card from "./Card/index.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { PRIMARY_TEXT } from "../lib/constants";
const allProjects = await getCollection("portfolio");
allProjects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

{
  allProjects.map((project) => (
    <Card colSpan="md:col-span-4 mb-10" rowSpan="md:row-span-5" href={`/projects/${project.id}`}>
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="flex flex-col gap-2 ms:w-4/5">
          <h2 class="text-xl font-bold" style={`color: ${PRIMARY_TEXT}`}>
            {project.data.title}
          </h2>
          {project.data.earlier && (
            <span class="text-xs uppercase tracking-wide text-gray-400 border border-neutral-600 rounded-lg px-2 py-1 w-fit">
              Earlier project
            </span>
          )}
          <p class="text-white">{project.data.description}</p>
          <p class="mt-auto" style={`color: ${PRIMARY_TEXT}`}>
            View case study →
          </p>
        </div>
        <Image
          src={project.data.image}
          alt={project.data.imageAlt}
          class="w-full h-48 object-cover rounded-lg self-center"
        />
      </div>
    </Card>
  ))
}
