---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { Image } from 'astro:assets';
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2"
  href="/work/nordic-charge"
>
  <div class="my-auto w-full">
    <div class="flex justify-between w-full items-start mb-2">
      <div class="flex flex-col">
        <h2>Nordic Charge</h2>
      </div>
      <Pulse />
    </div>
    <p class="text-xs">
      Building software for EV charging — Marketplace · Partner Portal · API v2
    </p>
    <Image src="/Work/NordicCharge.svg" alt="Logo of Nordic Charge" width="100" height="100" class="h-12 m-auto mt-2" />
  </div>
</Card>
