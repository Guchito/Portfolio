---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { Image } from 'astro:assets';
---

<Card
  colSpan="md:col-span-1 md:col-start-3 lg:col-start-auto"
  rowSpan="md:row-span-4 lg:row-span-2 md:row-start-5 lg:row-start-auto"
>
  <div class="my-auto w-full">
    <div class="flex justify-between w-full items-start mb-2">
      <div class="flex flex-col">
        <h2>Now</h2>
      </div>
      <Pulse />
    </div>
    <p class="text-xs">Currently working as Full-Stack developer at <b>Nordic Charge</b></p>
    <a href="https://www.nordiccharge.com/" target="_blank">
      <Image src="/Work/NordicCharge.svg" alt="Logo of Nordic Charge" width="100" height="100" class="h-12 m-auto mt-2" />
    </a>
  </div>
</Card>
