---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { Icon } from 'astro-icon/components'
import { getCollection } from "astro:content";
import { PRIMARY_TEXT } from "../lib/constants";
const allJobs = await getCollection("work");
allJobs.sort((a, b) => a.id.localeCompare(b.id));
---



{
    
    allJobs.map((job) => (
        
        <Card  colSpan="md:col-span-4 mb-6" rowSpan="md:row-span-5">
            <div class="flex flex-col sm:flex-row gap-1">
                <div class="flex flex-col p-4 ms:w-4/5">
                    <p class="text-white text-sm">{job.data.since} - {job.data.until} </p>
                    <h2 class="text-xl font-bold" style={`color: ${PRIMARY_TEXT}`}>{job.data.company}</h2>
                    <h3 class="text-white ">{job.data.title}</h3>
                    <p class="text-sm text-white">{job.data.description}</p>
                    {job.data.company === "Nordic Charge" && (
                        <a class="mt-2 font-bold" style={`color: ${PRIMARY_TEXT}`} href="/work/nordic-charge">
                            Read the full case study →
                        </a>
                    )}
                    <a class="mt-2" href={job.data.link} aria-label="Website" target="_blank">
                    <Button aria-label="Website">
                        <Icon name="ri:pages-line" class="h-6" />
                        <span class="sr-only">Website</span>
                    </Button>
                </a>
                </div>
            </div>
        </Card>

    ))
} 
